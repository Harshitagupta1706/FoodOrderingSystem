@model CustomerOrder
@{
    ViewData["Title"] = "Order confirmation";
}
<div class="confirmation-card">
    <div class="confirmation-mark">✓</div><span class="eyebrow">ORDER RECEIVED</span><h1>@(Model.Status == "Paid" || Model.Status.StartsWith("Placed") ? "Thank you for your order!" : "Order status")</h1>
    <p>Your order reference is <strong>#@Model.Id</strong>.</p>
    <div class="status-chip">@Model.Status</div>
    <div class="confirmation-details"><div><span>Customer</span><strong>@Model.CustomerName</strong></div><div><span>Payment</span><strong>@(Model.PaymentMethod == "COD" ? "Cash on Delivery" : "Online payment")</strong></div><div><span>Total</span><strong>₹@Model.TotalAmount.ToString("0.00")</strong></div></div>
    <h2>Order items</h2>
    @foreach (var item in Model.Items) { <div class="summary-line"><span>@item.ItemName × @item.Quantity</span><strong>₹@((item.UnitPrice * item.Quantity).ToString("0.00"))</strong></div> }
    <a class="btn btn-primary btn-wide" asp-controller="Home" asp-action="Index">Back to menu</a>
</div>
