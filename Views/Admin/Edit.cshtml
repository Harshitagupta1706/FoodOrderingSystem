@model MenuItem
@{
    ViewData["Title"] = "Edit menu item";
}
<div class="form-card narrow"><span class="eyebrow">MENU MANAGEMENT</span><h1>@(Model.Id == 0 ? "Add menu item" : "Edit menu item")</h1>
<form asp-action="Save" method="post"><input asp-for="Id" type="hidden" /><div asp-validation-summary="ModelOnly" class="validation"></div>
<label asp-for="Name"></label><input asp-for="Name" /><span asp-validation-for="Name" class="validation"></span>
<label asp-for="Description"></label><textarea asp-for="Description" rows="3"></textarea><span asp-validation-for="Description" class="validation"></span>
<label asp-for="Category"></label><input asp-for="Category" /><span asp-validation-for="Category" class="validation"></span>
<label asp-for="Price"></label><input asp-for="Price" type="number" step="0.01" min="1" /><span asp-validation-for="Price" class="validation"></span>
<label asp-for="ImageUrl"></label><input asp-for="ImageUrl" /><span asp-validation-for="ImageUrl" class="validation"></span>
<label class="payment-choice"><input asp-for="IsAvailable" /> <span><strong>Available on menu</strong></span></label>
<button class="btn btn-primary btn-wide">Save item</button><a class="back-link" asp-action="Menu">Cancel</a></form></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
