@model List<CustomerOrder>
@{
    ViewData["Title"] = "Admin dashboard";
}
<div class="admin-heading"><div><span class="eyebrow">CONTROL CENTRE</span><h1>Admin dashboard</h1></div><div class="admin-actions"><a class="btn btn-light" asp-action="Menu">Manage menu</a><form asp-action="Logout" method="post"><button class="btn btn-dark">Log out</button></form></div></div>
<div class="stats-grid"><div class="stat-card"><span>Menu items</span><strong>@ViewBag.ItemCount</strong></div><div class="stat-card"><span>Total orders</span><strong>@ViewBag.OrderCount</strong></div><div class="stat-card"><span>Order value</span><strong>₹@(((decimal)ViewBag.Revenue).ToString("0.00"))</strong></div></div>
<section class="table-card"><h2>Recent orders</h2>
@if (Model.Count == 0) { <p class="muted">No orders yet. Test checkout to see orders here.</p> } else {
<div class="table-wrap"><table><thead><tr><th>Order</th><th>Customer</th><th>Items</th><th>Total</th><th>Payment</th><th>Status</th><th>Update status</th></tr></thead><tbody>
@foreach (var o in Model) { <tr><td>#@o.Id<br /><small>@o.CreatedAt.ToLocalTime().ToString("dd MMM, HH:mm")</small></td><td>@o.CustomerName<br /><small>@o.Phone</small></td><td>@string.Join(", ", o.Items.Select(i => $"{i.ItemName} ×{i.Quantity}"))</td><td>₹@o.TotalAmount.ToString("0.00")</td><td>@o.PaymentMethod</td><td><span class="status-chip">@o.Status</span></td><td><form asp-action="UpdateStatus" method="post" class="inline-form"><input type="hidden" name="id" value="@o.Id" /><select name="status"><option>Preparing</option><option>Out for delivery</option><option>Delivered</option><option>Cancelled</option></select><button class="btn btn-dark btn-small">Save</button></form></td></tr> }
</tbody></table></div>
}
</section>
