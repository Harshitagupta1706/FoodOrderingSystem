<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · BiteRush</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header class="topbar">
    <a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">B</span><span>Bite<span class="brand-accent">Rush</span></span></a>
    <nav>
        <a asp-controller="Home" asp-action="Index">Menu</a>
        <a asp-controller="Cart" asp-action="Index">Cart</a>
        <a asp-controller="Admin" asp-action="Login">Admin</a>
    </nav>
</header>
<main class="page-shell">
    @if (TempData["Message"] is string message) { <div class="notice success">@message</div> }
    @RenderBody()
</main>
<footer><span>© @DateTime.Now.Year BiteRush Food Ordering</span><span>Fresh food. Fast delivery.</span></footer>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
