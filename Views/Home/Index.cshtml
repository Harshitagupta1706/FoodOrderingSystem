@model List<MenuItem>
@{
    ViewData["Title"] = "Fresh food, delivered";
    var categories = ViewBag.Categories as List<string> ?? new();
}
<section class="hero">
    <div class="hero-copy">
        <span class="eyebrow">GOOD FOOD, GOOD MOOD</span>
        <h1>Your cravings.<br><span>Our mission.</span></h1>
        <p>Freshly prepared favourites, delivered right to your door.</p>
        <a class="btn btn-primary" href="#menu">Explore menu <span>↓</span></a>
    </div>
    <div class="hero-art">
        <img src="https://images.unsplash.com/photo-1565299624946-b28f40a0ae38?auto=format&fit=crop&w=1200&q=85" alt="Fresh pizza on a table" />
        <div class="floating-note"><span>✦</span><div><strong>Made fresh</strong><small>Every single order</small></div></div>
    </div>
</section>
<section id="menu" class="menu-section">
    <div class="section-heading"><div><span class="eyebrow">THE GOOD STUFF</span><h2>Explore our menu</h2></div><span class="muted">@Model.Count delicious options</span></div>
    <form method="get" class="filters">
        <input name="q" value="@ViewBag.Query" placeholder="Search dishes..." aria-label="Search dishes" />
        <select name="category" aria-label="Category">
            <option value="All">All categories</option>
            @foreach (var c in categories) { <option value="@c" selected="@((string)ViewBag.Category == c)">@c</option> }
        </select>
        <button class="btn btn-dark" type="submit">Search</button>
        <a class="btn btn-light" asp-action="Index">Reset</a>
    </form>
    @if (Model.Count == 0) { <div class="empty-state"><h3>No dishes found</h3><p>Try another search or category.</p></div> }
    <div class="food-grid">
    @foreach (var item in Model)
    {
        <article class="food-card">
            <div class="food-photo"><img src="@item.ImageUrl" alt="@item.Name" loading="lazy" /><span class="category-pill">@item.Category</span></div>
            <div class="food-info"><div class="food-title-row"><h3>@item.Name</h3><strong class="price">₹@item.Price.ToString("0.00")</strong></div><p>@item.Description</p>
                <form asp-controller="Cart" asp-action="Add" method="post"><input type="hidden" name="id" value="@item.Id" /><button class="btn btn-primary add-btn" type="submit">＋ Add to cart</button></form>
            </div>
        </article>
    }
    </div>
</section>
